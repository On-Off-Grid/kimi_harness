#!/usr/bin/env bash
# pi-4.8 — flagship quality toggle for the pi-hunt stack (Kimi/Google era).
#
#   pi-4.8 on      flagship agents + coordinator -> Kimi K3.1 Pro (premium quality)
#   pi-4.8 off     flagship agents + coordinator -> Kimi K3            (conservative default)
#   pi-4.8         show current state (status)
#
# Fixed tiers this toggle NEVER touches:
#   - elite pair (strict-triager, hypothesis-redteam): always kimi-coding/k3.1-pro
#     (restored automatically if found off it)
#   - 8 mechanical agents: managed by pi-tier (provider-aware; currently google-direct/gemini-3.5-flash-lite)
#
# Effect applies to the NEXT `pi-hunt` launch and any new subagent spawns; a
# running session keeps its model until you relaunch or /model-switch it.
set -uo pipefail

AGENTS="$HOME/.pi/agent/agents"
PIHUNT="$HOME/.local/bin/pi-hunt"
SETTINGS="$HOME/.pi/agent/settings.json"

ELITE=(strict-triager hypothesis-redteam)
FAST=(h1-scope-loader intigriti-scope-loader yeswehack-scope-loader recon
      test-account-manager visual-security payload-researcher wordlist-curator)
DEFAULT_MODEL_ID="k3"
PREMIUM_MODEL_ID="k3.1-pro"

ok(){ printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
err(){ printf '  \033[1;31m✗ %s\033[0m\n' "$*"; }

is_in(){ local x; for x in "${@:2}"; do [ "$x" = "$1" ] && return 0; done; return 1; }

coord_model(){ grep -oE 'model kimi-coding/[a-zA-Z0-9.:-]+' "$PIHUNT" 2>/dev/null | head -1 | sed 's/^model //'; }

set_agent(){ # file, model-id
  sed -i -E "s|^model:\s*kimi-coding/[^ ]*$|model: kimi-coding/$2|" "$1"
}

set_coord(){ # model-id (keeps the :thinking suffix)
  local cur suffix=""
  cur=$(coord_model)
  [[ "$cur" == *:* ]] && suffix=":${cur#*:}"
  sed -i -E "s|--model kimi-coding/[a-zA-Z0-9.:-]+|--model kimi-coding/$1$suffix|" "$PIHUNT"
}

set_default_model(){ python3 - "$1" <<'PY'
import json, os, sys
p = os.path.expanduser("~/.pi/agent/settings.json")
d = json.load(open(p)); d["defaultModel"] = sys.argv[1]; json.dump(d, open(p, "w"), indent=2)
PY
}

elite_files(){ for a in "${ELITE[@]}"; do [ -f "$AGENTS/$a.md" ] && printf '%s\n' "$AGENTS/$a.md"; done; }

flagship_files(){
  for f in "$AGENTS"/*.md; do
    local a; a=$(basename "$f" .md)
    if ! is_in "$a" "${ELITE[@]}" && ! is_in "$a" "${FAST[@]}"; then printf '%s\n' "$f"; fi
  done
}

status(){
  local nf=0 ne=0 f
  printf '  coordinator : %s\n' "$(coord_model)"
  for f in "$AGENTS"/*.md; do
    local a m; a=$(basename "$f" .md)
    m=$(grep -m1 -oE 'kimi-coding/[a-zA-Z0-9.-]+' "$f" | sed 's|kimi-coding/||')
    if is_in "$a" "${ELITE[@]}"; then
      [ "$m" = "$PREMIUM_MODEL_ID" ] && ne=$((ne+1)) || { ne=$((ne+1)); printf '  NOTE: elite %s is on %s (expected %s)\n' "$a" "$m" "$PREMIUM_MODEL_ID"; }
    elif is_in "$a" "${FAST[@]}"; then nf=$((nf+1))
    fi
  done
  local non=0 npre=0
  while IFS= read -r f; do
    m=$(grep -m1 -oE 'kimi-coding/[a-zA-Z0-9.-]+' "$f" | sed 's|kimi-coding/||')
    [ "$m" = "$PREMIUM_MODEL_ID" ] && npre=$((npre+1)) || non=$((non+1))
  done < <(flagship_files)
  printf '  subagents   : %s flagship on K3 | %s on K3.1 Pro | %s mechanical (pi-tier)\n' "$non" "$npre" "$nf"
  printf '  elite pair  : %s/%s on %s\n' "$ne" "${#ELITE[@]}" "$PREMIUM_MODEL_ID"
  printf '  defaultModel: %s\n' "$(python3 -c 'import json,os;print(json.load(open(os.path.expanduser("~/.pi/agent/settings.json"))).get("defaultModel"))' 2>/dev/null)"
}

case "${1:-status}" in
  on)
    while IFS= read -r f; do set_agent "$f" "$PREMIUM_MODEL_ID"; done < <(flagship_files)
    set_coord "$PREMIUM_MODEL_ID"
    while IFS= read -r f; do set_agent "$f" "$PREMIUM_MODEL_ID"; done < <(elite_files)
    set_default_model "$PREMIUM_MODEL_ID"
    ok "flagship PREMIUM: coordinator + flagship agents -> $PREMIUM_MODEL_ID"
    status
    ;;
  off)
    while IFS= read -r f; do set_agent "$f" "$DEFAULT_MODEL_ID"; done < <(flagship_files)
    set_coord "$DEFAULT_MODEL_ID"
    while IFS= read -r f; do set_agent "$f" "$PREMIUM_MODEL_ID"; done < <(elite_files)
    set_default_model "$DEFAULT_MODEL_ID"
    ok "flagship CONSERVATIVE: coordinator + flagship agents -> $DEFAULT_MODEL_ID (elite stays $PREMIUM_MODEL_ID)"
    status
    ;;
  status|"") status;;
  -h|--help|help) sed -n '2,17p' "$0" | sed 's/^#\s\?//';;
  *) err "usage: pi-4.8 {on|off|status}"; exit 1;;
esac
