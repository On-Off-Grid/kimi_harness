#!/usr/bin/env python3
"""pihunt-authz — cross-team authz differential: find the forgotten sibling verb.

Reads a per-program authz-differential.jsonl (one row per resource type; each verb
carries its cross-team result). On a multi-tenant target the bug is rarely the verb
you test first — it is the sibling verb on the same resource where the boundary was
forgotten. This ranks resources by that risk:

  SPLIT    some verbs enforced, some UNTESTED  -> highest priority (boundary proven
           to exist, siblings unverified: a forgotten one is a live leak)
  OPEN     a verb returned enforced=false      -> a confirmed cross-team LEAK
  COLD     nothing tested yet                  -> untested surface (triage by age)
  CLEAR    every verb enforced                 -> boundary holds; park it

Reads only the differential file; prints no credentials.

Usage:
  pihunt-authz grid  [--program P]   full resource x verb grid
  pihunt-authz gaps  [--program P]   ranked untested/leaking cells only
  pihunt-authz report[--program P]   write structured-recon/authz-differential-report.md
Default program: digitalocean (or $PIHUNT_PROGRAM).
"""
import json
import os
import sys

def _find_root():
    # Walk up from the working directory to the repo (dir containing reports/),
    # so the tool works bare-on-PATH from the repo root or any subdir. Fall back
    # to the parent of the script's bin/ dir (repo-relative invocation).
    d = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(d, "reports")):
            return d
        p = os.path.dirname(d)
        if p == d:
            return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        d = p


ROOT = _find_root()
MARK = {True: "ENFORCED", False: "**LEAK**", None: "untested", "blocked": "blocked"}
CLASS_RANK = {"OPEN": 3, "SPLIT": 2, "COLD": 1, "CLEAR": 0}


def program(argv):
    for i, a in enumerate(argv):
        if a == "--program" and i + 1 < len(argv):
            return argv[i + 1]
    return os.environ.get("PIHUNT_PROGRAM", "digitalocean")


def recon_dir(prog):
    return os.path.join(ROOT, "reports", prog, "structured-recon")


def load(prog):
    path = os.path.join(recon_dir(prog), "authz-differential.jsonl")
    rows = []
    if not os.path.exists(path):
        sys.stderr.write(f"no authz-differential.jsonl for {prog}\n")
        return rows
    with open(path) as f:
        for ln in f:
            ln = ln.strip()
            if ln:
                rows.append(json.loads(ln))
    return [r for r in rows if r.get("kind") == "resource"]


def classify(res):
    vals = [v.get("enforced") for v in res.get("verbs", [])]
    if any(v is False for v in vals):
        return "OPEN"
    enforced = sum(1 for v in vals if v is True)
    untested = sum(1 for v in vals if v is None)
    if enforced and untested:
        return "SPLIT"
    if enforced and not untested:
        return "CLEAR"
    return "COLD"


def coverage(res):
    vals = [v.get("enforced") for v in res.get("verbs", [])]
    tested = sum(1 for v in vals if v in (True, False))
    return tested, len(vals)


def cmd_grid(prog, out=sys.stdout):
    res = load(prog)
    res.sort(key=lambda r: (CLASS_RANK[classify(r)], coverage(r)[1] - coverage(r)[0]),
             reverse=True)
    print(f"# Cross-team authz differential — {prog}\n", file=out)
    for r in res:
        t, n = coverage(r)
        print(f"## {r['resource']}  [{classify(r)}]  ({r.get('age','?')}) "
              f"— {t}/{n} verbs tested", file=out)
        for v in r.get("verbs", []):
            note = f"  ← {v['note']}" if v.get("note") else ""
            res_s = f"  ({v['result']})" if v.get("result") else ""
            print(f"    {MARK[v.get('enforced')]:<10} {v['verb']:<22} "
                  f"{v.get('endpoint','')}{res_s}{note}", file=out)
        print(file=out)


def cmd_gaps(prog, out=sys.stdout):
    res = load(prog)
    res.sort(key=lambda r: (CLASS_RANK[classify(r)], coverage(r)[1] - coverage(r)[0]),
             reverse=True)
    print(f"# Authz gaps (test these) — {prog}\n", file=out)
    print("# SPLIT first: the boundary is proven on a sibling, so an untested verb "
          "here is a likely live leak.\n", file=out)
    for r in res:
        cl = classify(r)
        if cl in ("CLEAR",):
            continue
        leaks = [v for v in r["verbs"] if v.get("enforced") is False]
        untested = [v for v in r["verbs"] if v.get("enforced") is None]
        if not leaks and not untested:
            continue
        print(f"[{cl}] {r['resource']} ({r.get('age','?')}):", file=out)
        for v in leaks:
            print(f"    !! LEAK {v['verb']} — {v.get('endpoint','')} ({v.get('result')})",
                  file=out)
        for v in untested:
            note = f" — {v['note']}" if v.get("note") else ""
            print(f"    .  test {v['verb']}: {v.get('endpoint','')}{note}", file=out)
        print(file=out)


def cmd_report(prog):
    import io
    path = os.path.join(recon_dir(prog), "authz-differential-report.md")
    buf = io.StringIO()
    buf.write(f"# Cross-team authz differential — {prog}\n\n")
    buf.write("Generated by `pihunt-authz report`. Source: `authz-differential.jsonl`.\n\n")
    buf.write("## Where the boundary may be forgotten (ranked)\n\n```\n")
    cmd_gaps(prog, out=buf)
    buf.write("```\n\n## Full grid\n\n```\n")
    cmd_grid(prog, out=buf)
    buf.write("```\n")
    with open(path, "w") as f:
        f.write(buf.getvalue())
    print(f"wrote {path}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, prog = argv[0], program(argv[1:])
    if cmd == "grid":
        cmd_grid(prog)
    elif cmd == "gaps":
        cmd_gaps(prog)
    elif cmd == "report":
        cmd_report(prog)
    else:
        sys.stderr.write(f"unknown command: {cmd}\n")
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
